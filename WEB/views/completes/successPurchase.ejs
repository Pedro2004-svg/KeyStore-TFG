<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto my-16 px-5 flex-1">
    <div class="bg-white rounded-xl p-10 shadow-lg text-center">

        <div class="text-7xl mb-5">🎉</div>
        <h2 class="text-green-500 text-3xl font-bold mb-2">¡Compra realizada con éxito!</h2>
        <p class="text-gray-500 text-base mb-8">Gracias por tu compra. Aquí tienes tus claves de activación:</p>

        <!-- Aviso -->
        <div class="bg-yellow-50 border border-yellow-300 rounded-lg px-4 py-3 text-yellow-800 text-sm mb-5 text-left">
            ⚠️ <strong>Guarda tus claves</strong> — no podrás volver a consultarlas desde aquí.
        </div>

        <!-- Claves -->
        <div class="bg-gray-50 rounded-lg p-5 my-5 text-left">
            <h3 class="text-gray-800 font-semibold text-lg mb-4">🔑 Tus claves de activación</h3>
            <div id="keysContainer">
                <div class="text-center text-gray-500 py-5">Cargando tus claves...</div>
            </div>
        </div>

        <button onclick="window.location.href='/'"
            class="bg-green-500 hover:bg-green-600 text-white border-none py-3.5 px-8 rounded-lg text-base font-semibold cursor-pointer transition-colors mt-2">
            🏠 Volver al catálogo
        </button>
    </div>
</div>

<script type="module" src="/js/successPurchase.js"></script>

<%- include('../partials/footer') %>
