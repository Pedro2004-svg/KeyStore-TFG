<%- include('../partials/header') %>

<div class="max-w-[1400px] mx-auto my-8 px-5 flex-1">
    <div class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow-md">
        <h2 class="text-gray-800 text-center text-2xl font-bold mb-8">Mi Perfil</h2>

        <!-- Cambiar Email -->
        <div class="mb-10 p-5 border border-gray-200 rounded-lg">
            <h3 class="text-gray-800 text-lg font-semibold mb-4">📧 Cambiar Email</h3>
            <form id="changeEmailForm">
                <div class="mb-5">
                    <label for="newEmail" class="block mb-1.5 text-gray-600 font-medium text-sm">Nuevo email</label>
                    <input type="email" id="newEmail" placeholder="nuevo@email.com" required
                        class="w-full px-3 py-3 border-2 border-gray-300 rounded-lg text-base focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <button type="submit"
                    class="w-full py-3 bg-indigo-500 hover:bg-indigo-600 text-white font-semibold rounded-lg text-lg cursor-pointer border-none transition-colors mt-2">
                    Cambiar Email
                </button>
                <div id="changeEmailMessage" class="hidden mt-4 px-3 py-3 rounded-lg text-center text-sm"></div>
            </form>
        </div>

        <!-- Cambiar Contraseña -->
        <div class="mb-10 p-5 border border-gray-200 rounded-lg">
            <h3 class="text-gray-800 text-lg font-semibold mb-4">🔒 Cambiar Contraseña</h3>
            <form id="changePasswordForm">
                <div class="mb-5">
                    <label for="oldPassword" class="block mb-1.5 text-gray-600 font-medium text-sm">Contraseña Actual</label>
                    <input type="password" id="oldPassword" name="oldPassword" required
                        class="w-full px-3 py-3 border-2 border-gray-300 rounded-lg text-base focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <div class="mb-5">
                    <label for="newPassword" class="block mb-1.5 text-gray-600 font-medium text-sm">Nueva Contraseña</label>
                    <input type="password" id="newPassword" name="newPassword"
                        class="w-full px-3 py-3 border-2 border-gray-300 rounded-lg text-base focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <div class="mb-5">
                    <label for="confirmNewPassword" class="block mb-1.5 text-gray-600 font-medium text-sm">Confirmar Nueva Contraseña</label>
                    <input type="password" id="confirmNewPassword" name="confirmNewPassword" required
                        class="w-full px-3 py-3 border-2 border-gray-300 rounded-lg text-base focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <button type="submit"
                    class="w-full py-3 bg-indigo-500 hover:bg-indigo-600 text-white font-semibold rounded-lg text-lg cursor-pointer border-none transition-colors mt-2">
                    Cambiar Contraseña
                </button>
                <div id="changePasswordMessage" class="hidden mt-4 px-3 py-3 rounded-lg text-center text-sm"></div>
            </form>
        </div>

        <!-- Zona de Peligro -->
        <div class="mb-2 p-5 border border-red-400 rounded-lg bg-red-50">
            <h3 class="text-red-600 text-lg font-semibold mb-3">⚠️ Zona de Peligro</h3>
            <p class="text-gray-600 mb-4 text-sm">Una vez que borres tu cuenta, no hay vuelta atrás. Por favor, está seguro.</p>
            <form id="deleteUserForm">
                <div class="mb-5">
                    <label for="deletePassword" class="block mb-1.5 text-gray-600 font-medium text-sm">Confirma tu contraseña para borrar la cuenta</label>
                    <input type="password" id="deletePassword" name="deletePassword" required
                        class="w-full px-3 py-3 border-2 border-gray-300 rounded-lg text-base focus:outline-none focus:border-red-400 transition-colors">
                </div>
                <button type="submit"
                    class="w-full py-3 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg text-lg cursor-pointer border-none transition-colors mt-2">
                    Borrar Mi Cuenta
                </button>
                <div id="deleteUserMessage" class="hidden mt-4 px-3 py-3 rounded-lg text-center text-sm"></div>
            </form>
        </div>

    </div>
</div>

<script type="module" src="/js/userProfile.js"></script>

<%- include('../partials/footer') %>
